{
	"luci-app-adguardhome": {
		"description": "Grant UCI access for luci-app-adguardhome",
		"read": {
			"file": {
				"/var/run/AdGredir": [ "read" ]
			},
			"ubus": {
				"service": [ "list" ],
				"luci.adguardhome": [ "getCoreInfo", "getRedirectStatus", "getCoreUpdate", "getBackupHistory", "getInterfaces", "getRuntimeLog", "getManualConfig" ]
			},
			"uci": [ "AdGuardHome" ]
		},
		"write": {
			"cgi-io": [ "upload" ],
			"file": {
				"/var/run/AdGuardHome-uploads/[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]/payload": [ "write" ]
			},
			"ubus": {
				"luci.adguardhome": [ "setVerboseLog", "startCoreUpdate", "prepareCoreUpload", "startCoreUpload", "cancelCoreUpload", "coreBackupAction", "changeWebPassword", "clearRuntimeLog", "setManualConfig" ]
			},
			"uci": [ "AdGuardHome" ]
		}
	}
}
