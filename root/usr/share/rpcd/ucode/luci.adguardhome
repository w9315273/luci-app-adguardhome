#!/usr/bin/ucode
'use strict';

import { stat, lstat, readlink, dirname, basename, open, popen, readfile, writefile, unlink, lsdir, mkdir, mkdtemp, rmdir, rename } from 'fs';
import { cursor } from 'uci';

function shellQuote(value) {
	return "'" + replace(value, /'/g, "'\\''") + "'";
}

function coreUpdateState() {
	const path = '/var/run/AdGuardHome-update.state';
	if (!stat(path))
		return 'idle';

	// 持读锁时读取最终状态, 避免把刚结束的任务误判为中途退出.
	const proc = popen('/usr/bin/flock -s -n -E 2 /var/lock/AdGuardHome-update.lock /bin/cat ' + path, 'r');
	if (!proc)
		die('Unable to read core update state');
	const state = trim(proc.read('all') || '');
	const rc = proc.close();
	if (rc == 2)
		return 'running';
	if (rc != 0)
		die('Unable to read core update state');
	return !state || state == 'running' ? 'failure' : state;
}

function backupRecord(path) {
	const info = lstat(path);
	if (info?.type != 'file' || info.size > 1024)
		return '';
	return split(readfile(path, 1024) || '', '\n')[0];
}

function getBackupHistory() {
	const conf = cursor();
	let path = conf.get('AdGuardHome', 'AdGuardHome', 'binpath') || '/usr/bin/AdGuardHome/AdGuardHome';
	let config = conf.get('AdGuardHome', 'AdGuardHome', 'configpath') || '/etc/AdGuardHome.yaml';
	if (substr(config, 0, 1) != '/')
		config = (conf.get('AdGuardHome', 'AdGuardHome', 'workdir') || '/usr/bin/AdGuardHome') + '/' + config;
	conf.unload('AdGuardHome');

	for (let i = 0; i < 40; i++) {
		const target = readlink(path);
		if (!target)
			break;
		path = substr(target, 0, 1) == '/' ? target : dirname(path) + '/' + target;
	}

	const result = {
		state: coreUpdateState(), core_exists: stat(path)?.type == 'file',
		config_exists: stat(config)?.type == 'file', entries: []
	};
	const dir = path + '.backups';
	if (lstat(dir)?.type == 'directory') {
		for (let id in (lsdir(dir) || [])) {
			if (!match(id, /^[0-9]{10}-[0-9]{4}$/))
				continue;
			const entry = dir + '/' + id;
			if (lstat(entry)?.type != 'directory')
				continue;
			const meta = match(backupRecord(entry + '/meta'), /^(manual|update) (v[^,[:space:]]+|-) ([0-9a-f]{64}|-) ([0-9a-f]{64}|-)$/);
			if (!meta || (meta[2] == '-') != (meta[3] == '-'))
				continue;
			const hasCore = meta[3] != '-' && lstat(entry + '/core')?.type == 'file';
			const hasConfig = meta[4] != '-' && lstat(entry + '/config.yaml')?.type == 'file';
			if (hasCore || hasConfig)
				push(result.entries, {
					id: id, created: int(substr(id, 0, 10), 10), source: meta[1],
					version: hasCore ? meta[2] : null, has_core: hasCore, has_config: hasConfig
				});
		}
	}

	// 旧版元数据可能在两次重命名之间中断, 读取与已发布核心对应的记录.
	const backup = path + '.prev';
	if (lstat(backup)?.type == 'file') {
		const meta = (!lstat(backup + '.new') && lstat(backup + '.meta.new')?.type == 'file')
			? backup + '.meta.new' : backup + '.meta';
		const version = match(backupRecord(meta), /^(v[^,[:space:]]+) [0-9a-f]{64}$/)?.[1];
		if (version)
			push(result.entries, {
				id: 'legacy', created: lstat(meta)?.mtime, source: 'legacy',
				version: version, has_core: true, has_config: false
			});
	}

	sort(result.entries, (a, b) => b.created - a.created || (a.id < b.id ? 1 : a.id > b.id ? -1 : 0));
	const failed = result.state == 'backup_failed' || result.state == 'restore_failed' ||
		result.state == 'restore_start_failed' || result.state == 'delete_failed';
	if (failed || result.state == 'backed_up' || result.state == 'restored') {
		const lines = split(trim(readfile('/tmp/AdGuardHome_update.log', 131072) || ''), '\n');
		const invalid = 'YAML configuration validation failed.';
		const skipped = 'YAML validation skipped: no core is installed.';
		if (failed)
			result.detail = index(lines, invalid) >= 0 ? invalid : lines[length(lines) - 1];
		else if (index(lines, skipped) >= 0)
			result.detail = skipped;
	}
	return result;
}

function startCoreTask(action, id, sha256) {
	const args = ['/bin/sh', '/usr/share/AdGuardHome/update_core.sh', '--background', action];
	if (id != null)
		push(args, id);
	if (sha256)
		push(args, sha256);
	const rc = system(args, 3000);
	return { started: rc == 0, reason: rc == 2 ? 'busy' : rc ? 'error' : '' };
}

const uploadRoot = '/var/run/AdGuardHome-uploads';

function clearUpload(dir) {
	unlink(dir + '/payload');
	unlink(dir + '/.session');
	return rmdir(dir);
}

function prepareCoreUpload(request) {
	mkdir(uploadRoot, 0o700);
	const root = lstat(uploadRoot);
	if (root?.type != 'directory' || root.uid != 0 || root.mode != 0o700)
		return {};

	// 页面关闭时可能来不及取消, 仅回收一小时未使用的待上传目录.
	for (let name in (lsdir(uploadRoot) || [])) {
		if (!match(name, /^[A-Za-z0-9]{6}$/))
			continue;
		const path = uploadRoot + '/' + name;
		const info = lstat(path);
		if (info?.type == 'directory' && info.mtime < time() - 3600)
			clearUpload(path);
	}

	const dir = mkdtemp(uploadRoot + '/XXXXXX');
	if (!dir)
		return {};
	if (writefile(dir + '/.session', request.args.ubus_rpc_session || 'local') == null) {
		clearUpload(dir);
		return {};
	}
	return { token: basename(dir), path: dir + '/payload' };
}

function ownedUpload(request) {
	const token = request.args.token;
	if (!match(token || '', /^[A-Za-z0-9]{6}$/))
		return null;
	const path = uploadRoot + '/' + token;
	if (lstat(path)?.type != 'directory' ||
	    readfile(path + '/.session', 33) != (request.args.ubus_rpc_session || 'local'))
		return null;
	return path;
}

return {
	'luci.adguardhome': {
		getRedirectStatus: {
			call: function() {
				const conf = cursor();
				function option(name, fallback) {
					const value = conf.get('AdGuardHome', 'AdGuardHome', name);
					return (type(value) == 'array' ? value[0] : value) || fallback;
				}
				const result = {
					mode: option('redirect', 'none'),
					enabled: option('enabled', '0') == '1',
					applied_mode: option('old_redirect', 'none'),
					applied_enabled: option('old_enabled', '0') == '1',
					binpath: option('binpath', '/usr/bin/AdGuardHome/AdGuardHome'),
					redirected: trim(readfile('/var/run/AdGredir') || '') == '1'
				};
				conf.unload('AdGuardHome');
				const lock = system(['/usr/bin/flock', '-n', '-E', '2',
					'/var/lock/AdGuardHome-redirect.lock', '/bin/true'], 3000);
				if (lock != 0 && lock != 2)
					die('Unable to check redirect status');
				result.busy = lock == 2;
				return result;
			}
		},
		getManualConfig: {
			call: function() {
				const conf = cursor();
				const configpath = conf.get('AdGuardHome', 'AdGuardHome', 'configpath') ||
					'/etc/AdGuardHome.yaml';
				conf.unload('AdGuardHome');

				const template = readfile('/usr/share/AdGuardHome/AdGuardHome_template.yaml') || '';
				const current = readfile(configpath);
				if (current != null)
					return { content: current, template: template, source: 'current' };
				if (stat(configpath) != null)
					return { content: '', template: template, source: 'error' };
				return {
					content: template,
					template: template,
					source: template ? 'template' : 'missing'
				};
			}
		},
		setManualConfig: {
			args: { content: '' },
			call: function(request) {
				const content = request.args.content;
				if (content == null)
					return { saved: false, reason: 'invalid_content' };

				const conf = cursor();
				const configpath = conf.get('AdGuardHome', 'AdGuardHome', 'configpath') ||
					'/etc/AdGuardHome.yaml';
				const binpath = conf.get('AdGuardHome', 'AdGuardHome', 'binpath') ||
					'/usr/bin/AdGuardHome/AdGuardHome';
				conf.unload('AdGuardHome');

				const temporaryConfig = '/tmp/AdGuardHometmpconfig.yaml';
				const validationLog = '/tmp/AdGuardHometest.log';
				if (writefile(temporaryConfig, replace(content, /\r\n/g, '\n')) == null)
					return { saved: false, reason: 'write_failed' };

				if (stat(binpath)?.type == 'file') {
					const valid = system(['/bin/sh', '-c', '"$1" -c "$2" --check-config > "$3" 2>&1',
						'sh', binpath, temporaryConfig, validationLog], 30000) == 0;
					if (!valid)
						return { saved: false, reason: 'validation_failed', log: readfile(validationLog) || '' };
				}

				if (writefile(configpath, readfile(temporaryConfig) || '') == null)
					return { saved: false, reason: 'save_failed' };
				unlink(temporaryConfig);
				if (system(['/etc/init.d/AdGuardHome', 'reload'], 30000) != 0)
					return { saved: false, reason: 'reload_failed' };
				return { saved: true };
			}
		},
		getInterfaces: {
			call: function() {
				return { interfaces: lsdir('/sys/class/net') || [] };
			}
		},
		getCoreInfo: {
			call: function() {
				const conf = cursor();
				const binpath = conf.get('AdGuardHome', 'AdGuardHome', 'binpath') ||
					'/usr/bin/AdGuardHome/AdGuardHome';
				const configpath = conf.get('AdGuardHome', 'AdGuardHome', 'configpath') ||
					'/etc/AdGuardHome.yaml';
				const result = {
					core_exists: stat(binpath)?.type == 'file',
					config_exists: stat(configpath)?.type == 'file',
					version: null
				};

				if (result.core_exists) {
					// Pass the configured path as a positional argument; capture both output streams.
					const proc = popen('/bin/sh -c \'"$1" --version 2>&1\' sh ' + shellQuote(binpath), 'r');
					if (proc) {
						const output = proc.read('all') || '';
						proc.close();
						result.version = match(output, /version ([^, \t\r\n]+)/)?.[1] || null;
					}
				}

				conf.unload('AdGuardHome');
				return result;
			}
		},
		getCoreUpdate: {
			call: function() {
				return {
					state: coreUpdateState(),
					log: readfile('/tmp/AdGuardHome_update.log', 131072) || ''
				};
			}
		},
		startCoreUpdate: {
			args: { force: false },
			call: function(request) {
				return startCoreTask(request.args.force ? 'force' : '');
			}
		},
		prepareCoreUpload: { call: prepareCoreUpload },
		startCoreUpload: {
			args: { token: '', sha256: '' },
			call: function(request) {
				const dir = ownedUpload(request);
				if (!dir)
					return { started: false, reason: 'invalid_upload' };
				const digest = lc(trim(request.args.sha256 || ''));
				const sha256 = match(digest, /^(sha256:)?([0-9a-f]{64})$/);
				if (digest && !sha256)
					return { started: false, reason: 'invalid_sha256' };
				const file = lstat(dir + '/payload');
				if (file?.type != 'file' || file.size < 1 || file.size > 128 * 1024 * 1024)
					return { started: false, reason: 'invalid_upload' };

				// 交接后的目录不在 CGI 可写路径内, 也不再接受页面的取消请求.
				const ready = uploadRoot + '/ready.' + request.args.token;
				if (lstat(ready) || !rename(dir, ready))
					return { started: false, reason: 'error' };
				unlink(ready + '/.session');
				const result = startCoreTask('upload', request.args.token, sha256?.[2]);
				if (!result.started)
					clearUpload(ready);
				return result;
			}
		},
		cancelCoreUpload: {
			args: { token: '' },
			call: function(request) {
				const dir = ownedUpload(request);
				return { cancelled: dir ? !!clearUpload(dir) : false };
			}
		},
		getBackupHistory: {
			call: getBackupHistory
		},
		coreBackupAction: {
			args: { action: '', backup_id: '' },
			call: function(request) {
				const action = request.args.action;
				if (action == 'backup-core' || action == 'backup-config' || action == 'backup')
					return startCoreTask(action);
				if (action != 'restore-core' && action != 'restore-config' && action != 'restore' && action != 'delete')
					return { started: false, reason: 'invalid_action' };
				const id = request.args.backup_id;
				if (!(id == 'legacy' && action != 'restore-config') && !match(id || '', /^[0-9]{10}-[0-9]{4}$/))
					return { started: false, reason: 'invalid_backup' };
				return startCoreTask(action, id);
			}
		},
		changeWebPassword: {
			args: { hash: '' },
			call: function(request) {
				const hash = request.args.hash;
				if (!match(hash, /^\$2[aby]\$(0[4-9]|[12][0-9]|3[01])\$[.\/A-Za-z0-9]{53}$/))
					return { changed: false, reason: 'invalid_hash' };

				const conf = cursor();
				const configpath = conf.get('AdGuardHome', 'AdGuardHome', 'configpath') ||
					'/etc/AdGuardHome.yaml';
				if (stat(configpath)?.type != 'file')
					return { changed: false, reason: 'no_config' };

				if (!conf.set('AdGuardHome', 'AdGuardHome', 'hashpass', hash) ||
					!conf.commit('AdGuardHome'))
					return { changed: false, reason: 'save_failed' };
				conf.unload('AdGuardHome');

				if (system(['/etc/init.d/AdGuardHome', 'reload'], 30000) != 0)
					return { changed: false, reason: 'reload_failed' };

				if (index(readfile(configpath) || '', hash) < 0)
					return { changed: false, reason: 'verify_failed' };
				return { changed: true };
			}
		},
		setVerboseLog: {
			args: { enabled: false },
			call: function(request) {
				const conf = cursor();
				if (!conf.set('AdGuardHome', 'AdGuardHome', 'verbose', request.args.enabled ? '1' : '0') ||
					!conf.commit('AdGuardHome'))
					return { saved: false, applied: false };
				conf.unload('AdGuardHome');
				return {
					saved: true,
					applied: system(['/etc/init.d/AdGuardHome', 'reload'], 30000) == 0
				};
			}
		},
		getRuntimeLog: {
			args: { offset: 0, identity: '' },
			call: function(request) {
				const conf = cursor();
				const logfile = conf.get('AdGuardHome', 'AdGuardHome', 'logfile') || '';
				conf.unload('AdGuardHome');
				if (!logfile)
					return { enabled: false, localtime: false, content: '', offset: 0 };

				let source = logfile;
				if (logfile == 'syslog') {
					source = '/tmp/AdGuardHometmp.log';
					writefile('/var/run/AdGuardHomesyslog', '1');
					if (stat(source)?.type != 'file')
						system(['/bin/sh', '-c', '/bin/sh /usr/share/AdGuardHome/getsyslog.sh >/dev/null 2>&1 &'], 3000);
				}

				// Bound memory and start with the most recent 256 KiB on a new view.
				const limit = 262144;
				const info = stat(source);
				const identity = info ? source + ':' + info.dev.major + ':' + info.dev.minor + ':' + info.inode : '';
				let offset = int(request.args.offset) || 0;
				let reset = request.args.identity != identity || offset < 0 || offset > (info?.size || 0);
				if (reset)
					offset = 0;
				if (info && info.size - offset > limit) {
					offset = info.size - limit;
					reset = true;
				}

				let content = '';
				if (info?.type == 'file') {
					const file = open(source, 'r');
					if (!file)
						die('Unable to open runtime log');
					const positioned = file.seek(offset);
					const chunk = positioned ? file.read(limit) : null;
					file.close();
					if (chunk == null)
						die('Unable to read runtime log');
					content = chunk;
				}

				return {
					enabled: true,
					localtime: logfile != 'syslog',
					// ubus strings stop at NUL; cleared files can contain sparse zero-filled gaps.
					content_b64: b64enc(content),
					offset: offset + length(content),
					identity: identity,
					reset: reset
				};
			}
		},
		clearRuntimeLog: {
			call: function() {
				const conf = cursor();
				const logfile = conf.get('AdGuardHome', 'AdGuardHome', 'logfile') || '';
				conf.unload('AdGuardHome');
				if (!logfile)
					return { cleared: false, reason: 'no_logfile' };

				const source = logfile == 'syslog' ? '/tmp/AdGuardHometmp.log' : logfile;
				return { cleared: writefile(source, '') != null };
			}
		}
	}
};
